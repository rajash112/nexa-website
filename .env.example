# NEXA website – environment variables
#
# Phase A (the static website) needs NO environment variables and NO secrets.
# Forms use Netlify Forms; fonts and icons are self-hosted.
#
# The variables below are placeholders for later phases (Phase B+). They are NOT read by any code yet.
# Never commit a real .env file. Never put service-role keys or passwords in client-side code.

# --- Phase B (not used yet): Supabase ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # server-side only (Netlify Functions), never exposed to the browser

# --- Phase B (not used yet): transactional e-mail ---
# EMAIL_API_KEY=

# --- Phase D (not used yet): sandboxed code-execution provider ---
# CODE_EXEC_API_KEY=              # server-side only
